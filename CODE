-- =====================================================================
-- COURIER MANAGEMENT SYSTEM DATABASE
-- DBMS Mini Project
-- =====================================================================
-- Models a real courier company (think DTDC / Blue Dart / FedEx):
-- branches book, route and deliver parcels ("shipments"), and every
-- shipment carries a live status history, just like a tracking page.
--
-- Run this whole file top to bottom in MySQL (8.0+):
--   mysql -u root -p < courier_management_system.sql
-- =====================================================================

DROP DATABASE IF EXISTS courier_management_system;
CREATE DATABASE courier_management_system;
USE courier_management_system;

-- =====================================================================
-- SECTION 1: TABLES
-- =====================================================================

-- ---------------------------------------------------------------------
-- 1.1 BRANCHES — every physical office of the courier company
-- ---------------------------------------------------------------------
CREATE TABLE branches (
    branch_id       INT AUTO_INCREMENT PRIMARY KEY,
    branch_name     VARCHAR(60)  NOT NULL,
    city            VARCHAR(40)  NOT NULL,
    state           VARCHAR(40)  NOT NULL,
    address         VARCHAR(150) NOT NULL,
    contact_number  VARCHAR(15)  NOT NULL,
    CONSTRAINT uq_branch_contact UNIQUE (contact_number)
);

-- ---------------------------------------------------------------------
-- 1.2 CUSTOMERS — people who book shipments (the senders)
-- ---------------------------------------------------------------------
CREATE TABLE customers (
    customer_id     INT AUTO_INCREMENT PRIMARY KEY,
    full_name       VARCHAR(60)  NOT NULL,
    phone           VARCHAR(15)  NOT NULL,
    email           VARCHAR(80),
    address         VARCHAR(150) NOT NULL,
    city            VARCHAR(40)  NOT NULL,
    CONSTRAINT uq_customer_phone UNIQUE (phone)
);

-- ---------------------------------------------------------------------
-- 1.3 EMPLOYEES — staff working out of a branch
-- ---------------------------------------------------------------------
CREATE TABLE employees (
    employee_id     INT AUTO_INCREMENT PRIMARY KEY,
    full_name       VARCHAR(60) NOT NULL,
    role            ENUM('Manager','Delivery Agent','Clerk','Driver') NOT NULL,
    branch_id       INT NOT NULL,
    phone           VARCHAR(15) NOT NULL,
    hire_date       DATE NOT NULL,
    FOREIGN KEY (branch_id) REFERENCES branches(branch_id)
        ON UPDATE CASCADE ON DELETE RESTRICT
);

-- ---------------------------------------------------------------------
-- 1.4 VEHICLES — delivery vehicles stationed at a branch
-- ---------------------------------------------------------------------
CREATE TABLE vehicles (
    vehicle_id      INT AUTO_INCREMENT PRIMARY KEY,
    vehicle_number  VARCHAR(20) NOT NULL UNIQUE,
    vehicle_type    ENUM('Bike','Van','Truck') NOT NULL,
    capacity_kg     DECIMAL(6,2) NOT NULL,
    branch_id       INT NOT NULL,
    FOREIGN KEY (branch_id) REFERENCES branches(branch_id)
        ON UPDATE CASCADE ON DELETE RESTRICT
);

-- ---------------------------------------------------------------------
-- 1.5 SHIPMENTS — the core entity: one row per parcel booked
-- ---------------------------------------------------------------------
CREATE TABLE shipments (
    shipment_id             INT AUTO_INCREMENT PRIMARY KEY,
    tracking_number         VARCHAR(15) NOT NULL UNIQUE,
    customer_id             INT NOT NULL,
    receiver_name           VARCHAR(60) NOT NULL,
    receiver_phone          VARCHAR(15) NOT NULL,
    receiver_address        VARCHAR(150) NOT NULL,
    origin_branch_id        INT NOT NULL,
    destination_branch_id   INT NOT NULL,
    package_weight_kg       DECIMAL(6,2) NOT NULL CHECK (package_weight_kg > 0),
    package_type            ENUM('Document','Parcel','Fragile') NOT NULL DEFAULT 'Parcel',
    booking_date             DATE NOT NULL,
    expected_delivery_date   DATE NOT NULL,
    delivered_date            DATE,
    current_status             ENUM('Booked','Picked Up','In Transit','Out for Delivery',
                                     'Delivered','Returned','Cancelled') NOT NULL DEFAULT 'Booked',
    shipping_cost               DECIMAL(8,2) NOT NULL,
    FOREIGN KEY (customer_id)           REFERENCES customers(customer_id) ON UPDATE CASCADE  ON DELETE RESTRICT,
    -- origin/destination stay ON UPDATE RESTRICT (not CASCADE): a CHECK constraint can't
    -- sit on a column that a cascading update might silently change without re-validating it
    FOREIGN KEY (origin_branch_id)      REFERENCES branches(branch_id)   ON UPDATE RESTRICT ON DELETE RESTRICT,
    FOREIGN KEY (destination_branch_id) REFERENCES branches(branch_id)   ON UPDATE RESTRICT ON DELETE RESTRICT,
    CONSTRAINT chk_origin_not_dest CHECK (origin_branch_id <> destination_branch_id)
);

CREATE INDEX idx_shipment_status   ON shipments(current_status);
CREATE INDEX idx_shipment_customer ON shipments(customer_id);

-- ---------------------------------------------------------------------
-- 1.6 DELIVERY_ASSIGNMENTS — which employee + vehicle handled which leg
--     of a shipment's journey (a shipment can have several legs: pickup,
--     a branch transfer, then final delivery)
-- ---------------------------------------------------------------------
CREATE TABLE delivery_assignments (
    assignment_id   INT AUTO_INCREMENT PRIMARY KEY,
    shipment_id     INT NOT NULL,
    employee_id     INT NOT NULL,
    vehicle_id      INT NOT NULL,
    assigned_date   DATE NOT NULL,
    leg             ENUM('Pickup','Transfer','Final Delivery') NOT NULL DEFAULT 'Final Delivery',
    FOREIGN KEY (shipment_id) REFERENCES shipments(shipment_id) ON UPDATE CASCADE ON DELETE CASCADE,
    FOREIGN KEY (employee_id) REFERENCES employees(employee_id) ON UPDATE CASCADE ON DELETE RESTRICT,
    FOREIGN KEY (vehicle_id)  REFERENCES vehicles(vehicle_id)   ON UPDATE CASCADE ON DELETE RESTRICT
);

-- ---------------------------------------------------------------------
-- 1.7 SHIPMENT_TRACKING — status history: the "live tracking" log
-- ---------------------------------------------------------------------
CREATE TABLE shipment_tracking (
    tracking_log_id INT AUTO_INCREMENT PRIMARY KEY,
    shipment_id     INT NOT NULL,
    status          ENUM('Booked','Picked Up','In Transit','Out for Delivery',
                          'Delivered','Returned','Cancelled') NOT NULL,
    location        VARCHAR(60) NOT NULL,
    updated_at      DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    remarks         VARCHAR(150),
    FOREIGN KEY (shipment_id) REFERENCES shipments(shipment_id) ON UPDATE CASCADE ON DELETE CASCADE
);

-- ---------------------------------------------------------------------
-- 1.8 PAYMENTS — one payment record per shipment
-- ---------------------------------------------------------------------
CREATE TABLE payments (
    payment_id      INT AUTO_INCREMENT PRIMARY KEY,
    shipment_id     INT NOT NULL UNIQUE,
    amount          DECIMAL(8,2) NOT NULL,
    payment_mode    ENUM('Cash','Card','UPI','Online') NOT NULL,
    payment_status  ENUM('Pending','Paid','Refunded') NOT NULL DEFAULT 'Pending',
    payment_date    DATE,
    FOREIGN KEY (shipment_id) REFERENCES shipments(shipment_id) ON UPDATE CASCADE ON DELETE CASCADE
);


