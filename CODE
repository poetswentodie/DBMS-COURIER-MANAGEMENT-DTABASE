-- =====================================================================
-- SECTION 3: VIEWS
-- =====================================================================

-- One row per shipment with sender, route and payment info joined in —
-- this is the query a front-end "track my order" page would run.
CREATE VIEW vw_shipment_details AS
SELECT
    s.shipment_id,
    s.tracking_number,
    c.full_name          AS sender_name,
    c.phone               AS sender_phone,
    s.receiver_name,
    s.receiver_phone,
    ob.branch_name          AS origin_branch,
    db.branch_name           AS destination_branch,
    s.package_weight_kg,
    s.package_type,
    s.current_status,
    s.booking_date,
    s.expected_delivery_date,
    s.delivered_date,
    s.shipping_cost,
    p.payment_status
FROM shipments s
JOIN customers c    ON s.customer_id = c.customer_id
JOIN branches  ob   ON s.origin_branch_id = ob.branch_id
JOIN branches  db   ON s.destination_branch_id = db.branch_id
LEFT JOIN payments p ON s.shipment_id = p.shipment_id;

-- Revenue and delivery count per branch — a manager's dashboard query.
CREATE VIEW vw_branch_performance AS
SELECT
    b.branch_id,
    b.branch_name,
    b.city,
    COUNT(s.shipment_id)                                                AS total_shipments_originated,
    SUM(CASE WHEN s.current_status = 'Delivered' THEN 1 ELSE 0 END)     AS delivered_count,
    ROUND(SUM(s.shipping_cost), 2)                                       AS total_revenue
FROM branches b
LEFT JOIN shipments s ON b.branch_id = s.origin_branch_id
GROUP BY b.branch_id, b.branch_name, b.city;


-- =====================================================================
-- SECTION 4: TRIGGER
-- =====================================================================

-- Every time a new tracking event is logged, the shipment's master
-- status (and delivered_date, if it just arrived) updates automatically
-- — you never have to update shipments and shipment_tracking separately.
DELIMITER $$

CREATE TRIGGER trg_sync_shipment_status
AFTER INSERT ON shipment_tracking
FOR EACH ROW
BEGIN
    UPDATE shipments
    SET current_status = NEW.status,
        delivered_date = CASE WHEN NEW.status = 'Delivered' THEN DATE(NEW.updated_at) ELSE delivered_date END
    WHERE shipment_id = NEW.shipment_id;
END$$

DELIMITER ;


-- =====================================================================
-- SECTION 5: STORED PROCEDURE
-- =====================================================================

-- Books a brand-new shipment end to end: works out the cost, generates
-- a tracking number, creates the shipment, logs its first tracking
-- event, and opens a pending payment record — one call instead of four.
DELIMITER $$

CREATE PROCEDURE sp_book_shipment (
    IN p_customer_id INT,
    IN p_receiver_name VARCHAR(60),
    IN p_receiver_phone VARCHAR(15),
    IN p_receiver_address VARCHAR(150),
    IN p_origin_branch_id INT,
    IN p_destination_branch_id INT,
    IN p_weight DECIMAL(6,2),
    IN p_package_type VARCHAR(20),
    IN p_expected_delivery_date DATE
)
BEGIN
    DECLARE v_cost DECIMAL(8,2);
    DECLARE v_tracking_number VARCHAR(15);
    DECLARE v_shipment_id INT;

    SET v_cost = CASE p_package_type
        WHEN 'Document' THEN 40.00
        WHEN 'Fragile'  THEN 80.00 + (p_weight * 60.00)
        ELSE 50.00 + (p_weight * 40.00)
    END;

    SET v_tracking_number = CONCAT('CMS', YEAR(CURDATE()), LPAD(FLOOR(RAND() * 999999), 6, '0'));

    INSERT INTO shipments (
        tracking_number, customer_id, receiver_name, receiver_phone, receiver_address,
        origin_branch_id, destination_branch_id, package_weight_kg, package_type,
        booking_date, expected_delivery_date, current_status, shipping_cost
    ) VALUES (
        v_tracking_number, p_customer_id, p_receiver_name, p_receiver_phone, p_receiver_address,
        p_origin_branch_id, p_destination_branch_id, p_weight, p_package_type,
        CURDATE(), p_expected_delivery_date, 'Booked', v_cost
    );

    SET v_shipment_id = LAST_INSERT_ID();

    INSERT INTO shipment_tracking (shipment_id, status, location, remarks)
    SELECT v_shipment_id, 'Booked', branch_name, 'Shipment booked'
    FROM branches WHERE branch_id = p_origin_branch_id;

    INSERT INTO payments (shipment_id, amount, payment_mode, payment_status)
    VALUES (v_shipment_id, v_cost, 'Cash', 'Pending');

    SELECT v_shipment_id AS new_shipment_id, v_tracking_number AS tracking_number, v_cost AS shipping_cost;
END$$

DELIMITER ;


-- =====================================================================
-- SECTION 6: DEMO QUERIES
-- Run these one at a time after the sections above to see the database
-- in action. Each is commented with what it demonstrates.
-- =====================================================================

-- Q1: Every shipment currently in transit, with full route + payment info
SELECT * FROM vw_shipment_details WHERE current_status = 'In Transit';

-- Q2: Revenue and delivery count per branch, busiest first
SELECT * FROM vw_branch_performance ORDER BY total_revenue DESC;

-- Q3: Top 3 employees by number of final deliveries handled
SELECT e.full_name, e.role, COUNT(da.assignment_id) AS deliveries_handled
FROM employees e
JOIN delivery_assignments da ON e.employee_id = da.employee_id
WHERE da.leg = 'Final Delivery'
GROUP BY e.employee_id, e.full_name, e.role
ORDER BY deliveries_handled DESC
LIMIT 3;

-- Q4: Full tracking history of shipment #1, most recent first
SELECT status, location, updated_at, remarks
FROM shipment_tracking
WHERE shipment_id = 1
ORDER BY updated_at DESC;

-- Q5: Shipments that arrived later than promised, and by how many days
SELECT tracking_number, booking_date, expected_delivery_date, delivered_date,
       DATEDIFF(delivered_date, expected_delivery_date) AS days_late
FROM shipments
WHERE delivered_date IS NOT NULL AND delivered_date > expected_delivery_date;

-- Q6: Customers who have booked more than one shipment (GROUP BY + HAVING)
SELECT c.full_name, COUNT(s.shipment_id) AS shipments_booked
FROM customers c
JOIN shipments s ON c.customer_id = s.customer_id
GROUP BY c.customer_id, c.full_name
HAVING COUNT(s.shipment_id) > 1;

-- Q7: Shipments with payment still pending
SELECT tracking_number, sender_name, shipping_cost, payment_status
FROM vw_shipment_details
WHERE payment_status = 'Pending';

-- Q8: Average shipping cost by package type
SELECT package_type, ROUND(AVG(shipping_cost), 2) AS avg_cost, COUNT(*) AS total_shipments
FROM shipments
GROUP BY package_type;

